        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 会在每次长休息前安排一次短休息。"
          }
        }
      }
    },
    "Pawse stores settings and session history locally on this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse guarda los ajustes y el historial de sesiones localmente en este Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawseは設定とセッション履歴をこのMac内に保存します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
