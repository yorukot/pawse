    "Custom images and authorized wallpaper folders use read-only bookmarks. Images are loaded locally and never uploaded.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes personalizadas y las carpetas de fondos autorizadas usan marcadores de solo lectura. Las imágenes se cargan localmente y nunca se suben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム画像と許可した壁紙フォルダには読み取り専用ブックマークを使用します。画像はローカルで読み込まれ、アップロードされません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂圖片與已授權的桌布資料夾會使用唯讀書籤。圖片只會在本機載入，絕不會上傳。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义图片和已授权的壁纸文件夹会使用只读书签。图片只会在本地加载，绝不会上传。"
          }
        }
      }
