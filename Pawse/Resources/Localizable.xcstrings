    "Estimates exclude pauses and natural-break waiting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estimaciones no incluyen las pausas ni la espera de un descanso natural."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測時間には一時停止と自然な休憩の待ち時間は含まれません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預估時間不包含暫停與等待自然休息的時間。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计时间不包括暂停和等待自然休息的时间。"
