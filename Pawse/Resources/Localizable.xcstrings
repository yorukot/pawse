    "Video-only desktop wallpapers are not supported. Breaks will use a dark background.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se admiten fondos de escritorio que sean solo vídeo. Los descansos usarán un fondo oscuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画のみのデスクトップ壁紙には対応していません。休憩には暗い背景を使用します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援僅限影片的桌布。休息時將使用深色背景。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持仅限视频的桌面壁纸。休息时将使用深色背景。"
          }
        }
      }
    },
