    "Access to the selected break image could not be refreshed. Choose it again in Appearance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo renovar el acceso a la imagen de descanso seleccionada. Vuelve a elegirla en Apariencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した休憩画像へのアクセスを更新できませんでした。「外観」で再度選択してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更新所選休息圖片的存取權限。請在「外觀」中重新選擇。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新所选休息图片的访问权限。请在“外观”中重新选择。"
          }
        }
      }
    },
    "Activity during the grace period returns Pawse to Break Pending and requires a fresh idle interval.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad durante el período de gracia devuelve Pawse a Descanso pendiente y exige un nuevo intervalo de inactividad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "猶予時間中に操作すると休憩保留中に戻り、新たなアイドル時間が必要になります。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在寬限期間內進行操作會讓 Pawse 返回「休息待定」，並需要重新累積閒置時間。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在宽限期内进行操作会让 Pawse 返回“休息待定”，并需要重新累计闲置时间。"
          }
        }
      }
    },
    "Actual": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Real"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實際"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际"
          }
        }
      }
    },
    "Adds one Focus duration to the timer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una duración de concentración al temporizador."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーに集中時間を1回分追加します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將一段專注時間加入計時器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将一段专注时间加入计时器。"
          }
        }
      }
    },
    "All Time": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el período"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全期間"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有時間"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有时间"
          }
        }
      }
    },
    "Allow Pawse in System Settings → General → Login Items.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Pawse en Ajustes del Sistema → General → Ítems de inicio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → 一般 → ログイン項目でPawseを許可してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定」→「一般」→「登入項目」中允許 Pawse。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”→“通用”→“登录项”中允许 Pawse。"
          }
        }
      }
    },
