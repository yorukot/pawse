            "value": "剩餘%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余%@"
          }
        }
      }
    },
    "%@ unit": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unidad: %@"
          }
        },
        "ja": {
          "stringUnit": {
