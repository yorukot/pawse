{
  "sourceLanguage": "en",
  "strings": {
    "%@ paused": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en pausa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は一時停止中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已暫停"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已暂停"
          }
        }
      }
    },
    "%@ remaining": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedan %@"
          }
        },
