            "state": "translated",
            "value": "Pawse 无法重新启动：%@。下次打开 Pawse 时会使用新语言。"
          }
        }
      }
    },
    "Pawse could not use or remember access to that image. Choose it again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse no pudo usar ni recordar el acceso a esa imagen. Vuelve a elegirla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その画像を使用できないか、アクセスを保存できませんでした。再度選択してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 無法使用該圖片或記住其存取權限。請重新選擇。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 无法使用该图片或记住其访问权限。请重新选择。"
          }
        }
      }
    },
    "Pawse does not collect telemetry or send analytics to a server.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse no recopila telemetría ni envía análisis a ningún servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawseはテレメトリを収集せず、分析データをサーバーに送信しません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 不會收集遙測資料，也不會將分析資料傳送到伺服器。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 不会收集遥测数据，也不会将分析数据发送到服务器。"
          }
        }
      }
    },
    "Pawse does not record which keys you press, where you move the pointer, what applications you use, or what is on your screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse no registra qué teclas pulsas, dónde mueves el puntero, qué aplicaciones usas ni qué aparece en tu pantalla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawseは、押したキー、ポインタの移動先、使用中のアプリ、画面の内容を記録しません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 不會記錄你按了哪些按鍵、將指標移到哪裡、使用哪些 App，或螢幕上的內容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 不会记录你按了哪些按键、将指针移到哪里、使用哪些 App，或屏幕上的内容。"
          }
        }
      }
    },
    "Pawse needs access to the folder containing this wallpaper. Choose Wallpaper Folder in Appearance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse necesita acceso a la carpeta que contiene este fondo de escritorio. Elige Carpeta de fondos en Apariencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この壁紙を含むフォルダへのアクセスが必要です。「外観」で「壁紙フォルダ」を選択してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 需要存取包含此桌布的資料夾。請在「外觀」中選擇「桌布資料夾」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 需要访问包含此壁纸的文件夹。请在“外观”中选择“壁纸文件夹”。"
          }
        }
      }
    },
    "Pawse schedules %lld Short Breaks before each Long Break.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse programa %lld descansos cortos antes de cada descanso largo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawseは長い休憩の前に短い休憩を%lld回設定します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 會在每次長休息前安排 %lld 次短休息。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 会在每次长休息前安排 %lld 次短休息。"
          }
        }
      }
    },
    "Pawse schedules one Short Break before each Long Break.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse programa un descanso corto antes de cada descanso largo."
