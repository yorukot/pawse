    "Wait for Natural Break": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperar a un descanso natural"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自然な休憩を待つ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待自然休息"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待自然休息"
          }
        }
      }
    },
    "Waiting for a natural stopping point…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando un punto de pausa natural…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自然な区切りを待っています…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待自然的停頓點…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待自然的停顿点…"
          }
        }
      }
    },
    "Wallpaper Folder": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta de fondos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙フォルダ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌布資料夾"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "壁纸文件夹"
          }
        }
      }
    },
    "Wallpaper folder access could not be refreshed. Choose the folder again in Appearance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo renovar el acceso a la carpeta de fondos. Vuelve a elegirla en Apariencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙フォルダへのアクセスを更新できませんでした。「外観」でフォルダを再度選択してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更新桌布資料夾的存取權限。請在「外觀」中重新選擇資料夾。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新壁纸文件夹的访问权限。请在“外观”中重新选择文件夹。"
          }
        }
      }
    },
    "Wallpaper folder access is no longer available. Choose the folder again in Appearance.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la carpeta de fondos ya no está disponible. Vuelve a elegirla en Apariencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙フォルダへのアクセスが利用できなくなりました。「外観」でフォルダを再度選択してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌布資料夾的存取權限已無法使用。請在「外觀」中重新選擇資料夾。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "壁纸文件夹的访问权限已无法使用。请在“外观”中重新选择文件夹。"
          }
        }
      }
    },
    "Wallpaper folder access is only needed when the current wallpaper is outside Pawse's sandbox. Images fill each display and receive a dark scrim for legibility. Solid Color uses a plain dark background.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la carpeta de fondos solo es necesario cuando el fondo actual está fuera del entorno aislado de Pawse. Las imágenes llenan cada pantalla y reciben una capa oscura para facilitar la lectura. Color sólido usa un fondo oscuro uniforme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙フォルダへのアクセスは、現在の壁紙がPawseのサンドボックス外にある場合のみ必要です。画像は各ディスプレイ全体に表示され、読みやすさのため暗い幕が重ねられます。「単色」では無地の暗い背景を使用します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有目前桌布位於 Pawse 沙盒之外時，才需要桌布資料夾的存取權限。圖片會填滿每部顯示器，並加上深色遮罩以保持文字清晰易讀。「純色」會使用單純的深色背景。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有当前壁纸位于 Pawse 沙盒之外时，才需要壁纸文件夹的访问权限。图片会填满每台显示器，并加上深色遮罩以保持文字清晰易读。“纯色”会使用纯深色背景。"
          }
        }
      }
    },
    "When a Focus session ends, wait until you stop using the keyboard and mouse before starting the break.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando termine una sesión de concentración, espera hasta que dejes de usar el teclado y el ratón antes de iniciar el descanso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中セッションの終了後、キーボードとマウスの操作が止まるまで待ってから休憩を開始します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專注工作階段結束後，等到你停止使用鍵盤與滑鼠再開始休息。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "专注会话结束后，等到你停止使用键盘和鼠标再开始休息。"
          }
        }
      }
    },
    "Your break is active on every display.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu descanso está activo en todas las pantallas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのディスプレイで休憩中です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有顯示器都已進入休息。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有显示器都已进入休息。"
          }
        }
      }
    },
    "macOS did not provide a desktop wallpaper. Breaks will use a dark background.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no proporcionó ningún fondo de escritorio. Los descansos usarán un fondo oscuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSからデスクトップ壁紙を取得できませんでした。休憩には暗い背景を使用します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未提供桌布。休息時將使用深色背景。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未提供桌面壁纸。休息时将使用深色背景。"
          }
        }
      }
    },
