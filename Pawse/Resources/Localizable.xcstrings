    "Pawse checks how long the Mac has been idle so it can start breaks at a natural stopping point.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse comprueba cuánto tiempo lleva el Mac inactivo para poder iniciar los descansos en un punto de pausa natural."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PawseはMacのアイドル時間を確認し、自然な区切りで休憩を開始します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 會檢查 Mac 的閒置時間，以便在自然的停頓點開始休息。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 会检查 Mac 的闲置时间，以便在自然的停顿点开始休息。"
          }
        }
      }
    },
    "Pawse could not cover every display. The break was canceled for safety.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse no pudo cubrir todas las pantallas. El descanso se canceló por seguridad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのディスプレイを覆うことができなかったため、安全のため休憩をキャンセルしました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 無法覆蓋所有顯示器。為確保安全，已取消休息。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 无法覆盖所有显示器。为确保安全，已取消休息。"
          }
        }
      }
    },
    "Pawse could not keep every display covered. The break was canceled for safety.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse no pudo mantener cubiertas todas las pantallas. El descanso se canceló por seguridad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのディスプレイを覆い続けることができなかったため、安全のため休憩をキャンセルしました。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 無法持續覆蓋所有顯示器。為確保安全，已取消休息。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 无法持续覆盖所有显示器。为确保安全，已取消休息。"
          }
        }
      }
    },
    "Pawse could not remember access to that folder. Choose it again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse no pudo recordar el acceso a esa carpeta. Vuelve a elegirla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのフォルダへのアクセスを保存できませんでした。再度選択してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 無法記住該資料夾的存取權限。請重新選擇。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 无法记住该文件夹的访问权限。请重新选择。"
          }
        }
      }
    },
    "Pawse could not restart. The new language will be used the next time you open Pawse.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse no pudo reiniciarse. El nuevo idioma se usará la próxima vez que abras Pawse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawseを再起動できませんでした。次回Pawseを開いたときに新しい言語が使用されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 無法重新啟動。下次開啟 Pawse 時會使用新語言。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse 无法重新启动。下次打开 Pawse 时会使用新语言。"
          }
        }
      }
    },
    "Pawse could not restart: %@. The new language will be used the next time you open Pawse.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawse no pudo reiniciarse: %@. El nuevo idioma se usará la próxima vez que abras Pawse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawseを再起動できませんでした：%@。次回Pawseを開いたときに新しい言語が使用されます。"
